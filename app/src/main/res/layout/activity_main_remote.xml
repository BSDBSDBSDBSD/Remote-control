<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:gravity="center_horizontal" android:background="#121212">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="BT Remote Control" android:textSize="22sp"
        android:textColor="#FFFFFF" android:textStyle="bold"
        android:layout_marginTop="32dp" android:layout_marginBottom="8dp"/>
    <TextView android:id="@+id/tvAccessibility"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Checking Accessibility..." android:textSize="13sp"
        android:padding="8dp" android:layout_marginBottom="16dp"
        android:background="#1E1E1E" android:textColor="#FFC107"/>
    <TextView android:id="@+id/tvStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Server off" android:textColor="#AAAAAA"
        android:textSize="14sp" android:layout_marginBottom="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="24dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Use Root"
            android:textColor="#FFFFFF" android:textSize="16sp"/>
        <Switch android:id="@+id/switchRoot"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button android:id="@+id/btnServer"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:text="Start Server (Controlled)" android:textSize="16sp"
        android:backgroundTint="#F44336" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnClient"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:text="Connect and Control Other Device" android:textSize="16sp"
        android:backgroundTint="#2196F3"/>
</LinearLayout>