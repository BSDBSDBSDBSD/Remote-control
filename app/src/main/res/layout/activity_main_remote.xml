<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E1A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#0F1628">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT Remote"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="-0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שליטה מרחוק"
                android:textSize="13sp"
                android:textColor="#5B8DDB"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_manage"
            android:background="@drawable/card_bg"
            android:tint="#AAAAAA"
            android:contentDescription="הגדרות"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="16dp"
        android:padding="14dp"
        android:background="@drawable/card_bg">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="שרת כבוי"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Accessibility + Root Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:padding="14dp"
        android:background="@drawable/card_bg">

        <LinearLayout
            android:id="@+id/layoutAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAccessibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ שירות נגישות כבוי"
                android:textColor="#FFC107"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnAccessibilityOpen"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="הפעל"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A3A5A"
                android:padding="4dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#2A2A3A" android:layout_marginVertical="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRootStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Root: לא פעיל"
                    android:textColor="#888888"
                    android:textSize="13sp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/switchRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Root"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:thumbTint="#EF4444"
                android:trackTint="#3A1A1A"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:text="▶  הפעל שרת  (מכשיר נשלט)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#EF4444"
        android:letterSpacing="0.02"/>

    <Button
        android:id="@+id/btnClient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:text="🔵  התחבר דרך Bluetooth"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"/>

    <Button
        android:id="@+id/btnClientWifi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="🌐  התחבר דרך WiFi Direct"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7C3AED"/>

    <!-- Info footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="BT Remote v1.1 • ללא אינטרנט, ללא Google"
        android:textSize="11sp"
        android:textColor="#444455"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

</LinearLayout>
