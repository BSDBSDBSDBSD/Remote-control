<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp"
            android:background="@drawable/bg_header_gradient">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_bg"
                android:text="🎮"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="שליטה מרחוק"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ללא אינטרנט · ללא Google"
                    android:textSize="13sp"
                    android:textColor="#E0E7FF"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_manage"
                android:background="@drawable/icon_bg"
                android:tint="#FFFFFF"
                android:contentDescription="הגדרות"
                android:padding="10dp"/>
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="18dp"
            android:padding="18dp"
            android:background="@drawable/card_bg">

            <View
                android:id="@+id/statusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_red"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="שרת כבוי"
                android:textColor="#CBD5E1"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- Enable radios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btnEnableBt"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="📶 בלוטוס + גלוי"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                app:cornerRadius="14dp"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnEnableWifi"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="📡 הפעל WiFi"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                app:cornerRadius="14dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Accessibility + Root Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:padding="18dp"
            android:background="@drawable/card_bg">

            <LinearLayout
                android:id="@+id/layoutAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚠️ שירות נגישות כבוי"
                    android:textColor="#FBBF24"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnAccessibilityOpen"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="הפעל"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    app:cornerRadius="12dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"/>
            </LinearLayout>

            <View
                android:id="@+id/dividerAccessibility"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22314F"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRootStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="‏Root: לא פעיל"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"/>

                <Switch
                    android:id="@+id/switchRoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Root"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:thumbTint="#EF4444"
                    android:trackTint="#3A1A1A"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Primary action -->
        <Button
            android:id="@+id/btnServer"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:text="▶  הפעל שרת  (מכשיר נשלט)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#EF4444"
            app:cornerRadius="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:text="התחברות למכשיר אחר"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:letterSpacing="0.08"/>

        <Button
            android:id="@+id/btnClient"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:text="🔵  התחבר דרך Bluetooth"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            app:cornerRadius="16dp"/>

        <Button
            android:id="@+id/btnClientWifi"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:text="🌐  התחבר דרך WiFi ישיר"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C3AED"
            app:cornerRadius="16dp"/>

        <!-- Footer / credit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="18dp"
            android:text="נבנה על ידי ‎@בסדבסד · מתמחים טופ · בעזרת Claude"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
