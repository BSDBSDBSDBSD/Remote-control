<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1923">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1A0D1A">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖥️ שלט רחוק BT"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שליטה מרחוק במכשיר אחר"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="16dp"
        android:padding="14dp"
        android:background="@drawable/card_bg">
        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="שרת כבוי"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Accessibility Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:padding="14dp"
        android:background="@drawable/card_bg">
        <TextView
            android:id="@+id/tvAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ שירות נגישות כבוי — לחץ להפעלה"
            android:textColor="#FFC107"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/tvRootStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Root: לא פעיל"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>
        <Switch
            android:id="@+id/switchRoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הפעל Root"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Server Button -->
    <Button
        android:id="@+id/btnServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:text="הפעל שרת (מכשיר נשלט)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF"/>

    <!-- BT Client Button -->
    <Button
        android:id="@+id/btnClient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:text="התחבר דרך Bluetooth (שליטה)"
        android:textSize="15sp"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"/>

    <!-- WiFi Client Button -->
    <Button
        android:id="@+id/btnClientWifi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="התחבר דרך WiFi Direct (שליטה)"
        android:textSize="15sp"
        android:backgroundTint="#7C3AED"
        android:textColor="#FFFFFF"/>

</LinearLayout>
