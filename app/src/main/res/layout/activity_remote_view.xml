<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <!-- Screen area -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/ivRemoteScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="#0A0A0A"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#5B8DDB"/>

        <!-- Status bar overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CC000000"
            android:padding="5dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="4dp"/>

            <TextView
                android:id="@+id/tvFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 fps"
                android:textSize="11sp"
                android:textColor="#22C55E"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>

    </FrameLayout>

    <!-- Side control panel -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#111827"
        android:padding="4dp">

        <!-- Volume -->
        <Button
            android:id="@+id/btnVolUp"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="▲"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F2937"
            android:layout_marginBottom="2dp"
            android:padding="0dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOL"
            android:textSize="8sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="2dp"/>

        <Button
            android:id="@+id/btnVolDown"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="▼"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F2937"
            android:layout_marginBottom="10dp"
            android:padding="0dp"/>

        <!-- Nav buttons -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="◀"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F2937"
            android:layout_marginBottom="2dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnHome"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="⌂"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F2937"
            android:layout_marginBottom="2dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnRecents"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="⊞"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F2937"
            android:layout_marginBottom="10dp"
            android:padding="0dp"/>

        <!-- Feature buttons -->
        <Button
            android:id="@+id/btnApps"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="Apps"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D4ED8"
            android:layout_marginBottom="4dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnClipboard"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="Clip"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0F766E"
            android:layout_marginBottom="4dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnShell"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="Shell"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#92400E"
            android:layout_marginBottom="4dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="↻"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#14532D"
            android:layout_marginBottom="4dp"
            android:padding="0dp"/>

        <Button
            android:id="@+id/btnRoot"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:text="Root"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7F1D1D"
            android:padding="0dp"/>

    </LinearLayout>
</LinearLayout>
